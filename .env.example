# キーの一覧と意味は docs/design.md §9 が正。ここは値の雛形のみ。
#
# 使い方:  cp .env.example .env  して空欄を埋める
# .env はコミットしない（.gitignore 済み）。このファイルはコミットする。

# ── db（ローカルのみ。本番は Render マネージド）───────────
POSTGRES_USER=hackstage
POSTGRES_PASSWORD=
POSTGRES_DB=hackstage

# DATABASE_URL はここに書かない。
# compose.yaml が上の POSTGRES_* から組み立てて dev / api に渡す。
# 資格情報を 2 箇所に持たないため（docs/design.md §9）

# ── api ───────────────────────────────────────────────────
FLASK_ENV=development

# 任意の文字列。ローカル専用なので使い回さないこと。
# 本番は Render ダッシュボードで手入力する（sync: false）
SECRET_KEY=

# ローカルは HTTP なので false。本番は true
SESSION_COOKIE_SECURE=false

# ── web ───────────────────────────────────────────────────
# ローカルと本番で同じ値。localhost にしないこと（docs/design.md §5）
API_INTERNAL_URL=http://api:8000
NODE_ENV=development

# ── VPS本番デプロイ時のみ使う（compose.prod.yaml の caddy が読む）───
# VultrのIPを nip.io 形式にしたもの。例: 123-45-67-89.nip.io
# 手順は docs/vps-deploy.md 参照
PUBLIC_DOMAIN=
