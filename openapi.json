    "/api/reactions": {
      "get": {
        "summary": "対象(投稿/予定)のリアクション一覧を取得する",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reaction"
                  }
                }
              }
            }
          },
          "400": {
            "description": "target_type・target_idが不正"
          },
          "401": {
            "description": "未ログイン"
          }
        }
      },
      "post": {
        "summary": "リアクションを追加する。user_idはクライアントから指定できない",
