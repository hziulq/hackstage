        }
      },
      "post": {
        "summary": "投稿を作成する。user_idはクライアントから指定できない",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Post"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作成成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "400": {
            "description": "入力エラー"
          },
          "401": {
            "description": "未ログイン"
          },
          "404": {
            "description": "calendar_id指定時、参加していないカレンダー"
          }
        }
      }
    },
    "/api/posts/{post_id}/comments": {
      "get": {
        "summary": "投稿のコメント一覧を取得する",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PostComment"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未ログイン"
          },
          "404": {
            "description": "対象の投稿が存在しない"
          }
        }
      },
      "post": {
        "summary": "投稿にコメントを追加する。user_idはクライアントから指定できない",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostComment"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "作成成功",
