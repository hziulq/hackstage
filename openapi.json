                  "$ref": "#/components/schemas/PostComment"
                }
              }
            }
          },
          "400": {
            "description": "入力エラー"
          },
          "401": {
            "description": "未ログイン"
          },
          "404": {
            "description": "対象の投稿が存在しない"
          }
        }
      }
    },
    "/api/goals": {
      "get": {
        "summary": "自分の目標一覧を取得する",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Goal"
                  }
                }
              }
            }
          },
          "401": {
            "description": "未ログイン"
          }
        }
      },
      "post": {
        "summary": "目標を作成する(マイルストーン自動生成込み)。user_idはクライアントから指定できない",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
