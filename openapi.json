  "openapi": "3.0.3",
  "components": {
    "schemas": {
      "Register": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "display_name",
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "email": {
            "type": "string",
            "format": "email",
            "readOnly": true
          },
          "display_name": {
            "type": "string",
            "readOnly": true
          },
          "avatar_url": {
            "type": "string",
            "readOnly": true,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "user_id": {
            "type": "integer",
            "readOnly": true
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "is_done": {
            "type": "boolean"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "readOnly": true
          },
          "user_id": {
            "type": "integer",
            "readOnly": true
          },
          "category": {
            "type": "string",
            "enum": [
              "anonymous_qa",
              "prefecture_intern_info",
              "timeline"
            ]
          },
          "calendar_id": {
            "type": "integer",
            "nullable": true
